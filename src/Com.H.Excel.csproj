<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Com.H.Excel</RootNamespace>
    <AssemblyName>Com.H.Excel</AssemblyName>
    <FileVersion></FileVersion>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Copyright>Hussein Al Bayati</Copyright>
    <Authors>Hussein Al Bayati</Authors>
    <PackageIcon>128x128.jpg</PackageIcon>
    <PackageReadmeFile>nuget.md</PackageReadmeFile>
    <Version>10.1.1</Version>
    <PackageReleaseNotes>Read path: resolve custom number-format codes from the workbook's numFmts (e.g. openpyxl's numFmtId=164 with formatCode "yyyy-mm-dd h:mm:ss"), so date cells written as t="n" with a custom style now parse to DateTime instead of returning the raw OADate string. Also classifies custom decimal/integer formats. Stops assuming numFmtIds 164/165/166 have fixed meanings.</PackageReleaseNotes>
    <PackageTags>excel, xlsx, openxml, dynamic, ExpandoObject</PackageTags>
    <Description>Easy reading / writing / streaming Excel (xlsx) files.</Description>
    <PackageProjectUrl>https://github.com/H7O/Com.H.Excel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/H7O/Com.H.Excel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Embedded debug symbols for downstream debugging -->
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

  </PropertyGroup>

  <ItemGroup>
    <None Include="..\128x128.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="[3.5.1,4.0.0)" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.202" PrivateAssets="All" />
  </ItemGroup>

</Project>
